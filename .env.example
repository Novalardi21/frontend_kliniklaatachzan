# Jangan commit .env yang berisi password asli.
# setup-admin.ps1 mengisi variabel ini secara otomatis untuk lokal.
NUXT_DATABASE_URL=postgresql://postgres:ISI_PASSWORD_LOKAL@127.0.0.1:5432/mylaatachzan
# Railway: URL origin website HTTPS (tanpa slash akhir).
# NUXT_SITE_URL=https://nama-aplikasi.up.railway.app
# Nomor petugas untuk antrean notifikasi, format 628xxxxxxxxxx.
# NUXT_BOOKING_STAFF_PHONE=
# Fonnte (isi token asli hanya di Railway Variables atau .env).
# NUXT_WHATSAPP_PROVIDER=fonnte
# NUXT_WHATSAPP_FONNTE_TOKEN=
# WhatsApp Cloud API (gunakan NUXT_WHATSAPP_PROVIDER=meta).
# NUXT_WHATSAPP_ACCESS_TOKEN=
# NUXT_WHATSAPP_PHONE_NUMBER_ID=
# NUXT_WHATSAPP_GRAPH_VERSION=
# Cookie Secure otomatis aktif saat build produksi.
